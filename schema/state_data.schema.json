{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mortgage vs Income State Data",
  "description": "Per-state (or national) weekly mortgage affordability data with metadata.",
  "type": "object",
  "required": ["single_costs", "household_costs", "metadata"],
  "additionalProperties": false,
  "properties": {
    "single_costs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/costEntry" }
    },
    "household_costs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/costEntry" }
    },
    "metadata": {
      "type": "object",
      "required": ["generated_at", "state", "state_name", "frequency", "date_range"],
      "additionalProperties": false,
      "properties": {
        "generated_at": { "type": "string" },
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "state_name": { "type": "string" },
        "frequency": { "type": "string" },
        "date_range": {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "last_actual_home_price": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "last_actual_income": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "actual": { "type": "integer", "minimum": 0 },
            "estimated": { "type": "integer", "minimum": 0 },
            "income_estimated": { "type": "integer", "minimum": 0 }
          }
        },
        "series_quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observed": { "type": "integer", "minimum": 0 },
            "interpolated": { "type": "integer", "minimum": 0 },
            "extrapolated": { "type": "integer", "minimum": 0 }
          }
        },
        "data_sources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bls_series": { "type": "string" },
            "fred_home_price": { "type": "string" },
            "fred_mortgage": { "type": "string" },
            "qcew_income_multiplier": { "type": "number" },
            "qcew_year": { "type": "integer" },
            "qcew_multiplier_source": {
              "type": "string",
              "pattern": "^(qcew_\\d{4}|fallback_missing|fallback_unavailable)$"
            }
          }
        },
        "methodology": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "loan_term_months": { "type": "integer" },
            "household_multiplier": { "type": "number" },
            "home_price_estimation": { "type": "string" },
            "home_price_interpolation": { "type": "string" },
            "income_estimation": { "type": "string" },
            "income_note": { "type": "string" },
            "date_alignment": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      }
    }
  },
  "definitions": {
    "costEntry": {
      "type": "object",
      "required": ["type", "date", "total_cost", "cost_to_income", "home_price", "mortgage_rate"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["single", "household"] },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "total_cost": { "type": "integer", "minimum": 0 },
        "single_income": { "type": "integer", "minimum": 0 },
        "household_income": { "type": "integer", "minimum": 0 },
        "cost_to_income": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
        "home_price": { "type": "integer", "minimum": 0 },
        "mortgage_rate": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
        "observed": { "type": "boolean" },
        "estimated": { "type": "boolean" },
        "estimation_details": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "price_estimated": { "type": "boolean" },
            "rate_estimated": { "type": "boolean" },
            "income_estimated": { "type": "boolean" }
          }
        },
        "rate_gap_days": { "type": "integer", "minimum": 0 },
        "cpi": { "type": "number", "minimum": 0 }
      }
    }
  }
}
