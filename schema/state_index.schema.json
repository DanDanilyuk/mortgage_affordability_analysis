{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mortgage vs Income State Index",
  "description": "Latest-snapshot roll-up of every state's most recent reading (data/index.json), built by build_state_index and consumed by the all-states ranking grid. Distinct shape from the per-state files, so it has its own schema.",
  "type": "object",
  "required": ["generated_at", "states"],
  "additionalProperties": false,
  "properties": {
    "generated_at": { "type": "string" },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "state",
          "state_name",
          "date",
          "latest_ratio_single",
          "latest_ratio_household",
          "latest_home_price",
          "latest_mortgage_rate"
        ],
        "additionalProperties": false,
        "properties": {
          "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "state_name": { "type": "string" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "latest_ratio_single": { "type": "number" },
          "latest_ratio_household": { "type": "number" },
          "latest_home_price": { "type": "number" },
          "latest_mortgage_rate": { "type": "number" }
        }
      }
    }
  }
}
